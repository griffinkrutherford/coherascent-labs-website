 import { registerRootComponent } from "expo";
-import { createElement } from "react";
-import { Platform, Settings } from "react-native";
-import App from "./App";
-// Side-effect only: registers whichever native widget store module (iOS/
-// Android) has landed on this branch with src/widget/widgetStoreRegistry.ts.
-import "./src/widget";
-import { registerLuneSynthWidgetTaskHandler } from "./src/widget/android/androidWidgetTaskHandler";
-import { DevShowcaseRoot } from "./src/screens/dev/notesShowcase/DevShowcaseRoot";
-import { resolveDevShowcaseVariant, resolveAndroidDevShowcaseVariant } from "./src/screens/dev/notesShowcase/devShowcaseVariant.core";
-import { readLaunchArgument } from "./src/performance/deviceSignals";
-
-// three's log filter is no longer installed here: importing it forced all of
-// three.js into the startup graph. src/config/threeRuntime.ts installs it the
-// first time three loads, which is still before any <Canvas> can mount.
-
-// Home-screen widget (Android): registers the headless task that redraws
-// LuneSynthWidget on WIDGET_ADDED/UPDATE/RESIZED/CLICK. No-ops on iOS and on
-// any binary built before `react-native-android-widget` was linked.
-registerLuneSynthWidgetTaskHandler();
-
-// DEV-ONLY screenshot harness (docs/2026-10-02-notability-grade-notes-plan.md,
-// src/screens/dev/notesShowcase/DevShowcaseRoot.tsx). `xcrun simctl launch
-// <udid> com.coherascentlabs.lunesynth -lunaDevScreen <variant>` lands
-// `<variant>` in iOS's launch-argument NSUserDefaults domain, which
-// `Settings.get` (react-native, iOS-only) reads back. `__DEV__` is first in
-// this `&&` chain -- it is a compile-time constant Metro replaces with
-// `false` in a release bundle, so in a release build this whole expression
-// short-circuits to `null` without ever evaluating `Platform.OS` or calling
-// `Settings.get`: dead code, not just a false branch.
-//
-// Android QA can use the existing native intent helper; older binaries fall back to Metro.
-// Android has no equivalent of NSUserDefaults launch arguments, so the
-// Android branch instead reads `EXPO_PUBLIC_LUNA_DEV_SCREEN`, an
-// EXPO_PUBLIC_-prefixed env var Metro inlines into the bundle at transform
-// time (the same mechanism this app already uses for
-// `EXPO_PUBLIC_API_BASE_URL`/`EXPO_PUBLIC_FLOW_TIMER`), set when starting
-// Metro: `EXPO_PUBLIC_LUNA_DEV_SCREEN=<variant> npx expo start --dev-client -c`.
-// `__DEV__` gates this branch too, so it is equally dead code in a release
-// bundle; changing the variant requires a Metro restart with `-c` to clear
-// the inline-env cache, which is already this harness's normal workflow.
-const devShowcaseVariant =
-  __DEV__ && Platform.OS === "ios"
-    ? resolveDevShowcaseVariant(Settings.get("lunaDevScreen"), __DEV__)
-    : __DEV__ && Platform.OS === "android"
-      ? resolveAndroidDevShowcaseVariant(readLaunchArgument("lunaDevScreen"), process.env.EXPO_PUBLIC_LUNA_DEV_SCREEN, __DEV__)
-      : null;
-
-// Frame-measurement builds only (docs/2026-10-10-low-end-device-performance.md).
-// A release-mode bundle built with EXPO_PUBLIC_LUNA_PERF_HARNESS=1 opens a
-// showcase named by a launch argument (`am start --es lunaDevScreen <variant>`),
-// so low-end frame stats come from production JS instead of dev JS. Store
-// builds never set the flag: Metro inlines the missing variable as undefined
-// and this is null without reading anything.
-const perfHarnessVariant =
-  !devShowcaseVariant && process.env.EXPO_PUBLIC_LUNA_PERF_HARNESS === "1"
-    ? resolveAndroidDevShowcaseVariant(readLaunchArgument("lunaDevScreen"), process.env.EXPO_PUBLIC_LUNA_DEV_SCREEN, true)
-    : null;
-
-// registerRootComponent calls AppRegistry.registerComponent('main', () => App);
-// It also ensures that whether you load the app in Expo Go or in a native build,
-// the environment is set up appropriately.
-// index.ts is a plain .ts file (JSX syntax is only valid in .tsx), so this
-// uses createElement directly instead of <DevShowcaseRoot ... />.
-registerRootComponent(
-  devShowcaseVariant
-    ? () => createElement(DevShowcaseRoot, { variant: devShowcaseVariant })
-    : perfHarnessVariant
-      ? () => createElement(DevShowcaseRoot, { variant: perfHarnessVariant })
-      : App
-);
+import VoiceCallRecording from "./VoiceCallRecording";
+registerRootComponent(VoiceCallRecording);
